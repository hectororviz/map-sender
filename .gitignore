# ---> This .gitignore is for an Android/Kotlin project, no secrets included.
*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
/build/
/app/build/
/captures
.externalNativeBuild
.cxx
local.properties
*.hprof
# Keystore de DEPURACIÓN fijo: se versiona a propósito para que todos los
# APK de CI compartan firma. No poner aquí keystores de release.
!app/debug.keystore
*.jks
google-services.json
# Keystore / signing
keystore.properties
# Test / coverage
*.exec
# OS
Thumbs.db
